{
  "name": "aura-link-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Aura Link: recomendador de rutas multimodales (TP + bici + a pie) por tiempo, coste y emisiones",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "bench": "vitest run src/domain/raptor.bench.test.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.11.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
